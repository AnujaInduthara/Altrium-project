# Copy this file to backend/.env and fill in the Supabase values.
#
# The app is designed to run on any laptop with no other changes: the backend
# already allows localhost and private-LAN browser origins, and the frontend
# calls the API on whatever host served the page (port 5000). You only need to
# set the CORS/URL variables below for a real deployment.

PORT=5000

# Origin(s) of the static frontend, comma-separated. Optional — localhost and
# private-LAN origins on any port are allowed automatically.
FRONTEND_URL=http://127.0.0.1:5500

# Fallback base URL for a published vacancy's public application link, used only
# when an API request has no Origin header. Optional.
APP_URL=http://127.0.0.1:5500

# Extra allowed browser origins, comma-separated (e.g. a deployed frontend URL).
# CORS_ORIGINS=https://recruit.example.com

# "true" reflects EVERY origin. Only use behind a trusted proxy.
# CORS_ALLOW_ANY=false

# Max CV upload size in bytes. Default 5242880 (5 MiB).
# CV_MAX_BYTES=5242880

# Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only secret. Never expose to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
 
# --- PB-05: AI CV screening (server-side only) --------------------------------
# Screening runs automatically after an application is stored. If no provider
# key is set, screening stays "pending" and the rest of the app is unaffected.

# Provider abstraction. Supported: groq (default), anthropic
AI_PROVIDER=groq
# Provider-specific model id (not hardcoded anywhere in the code).
# Groq example: openai/gpt-oss-120b        Anthropic example: claude-opus-5
AI_MODEL=openai/gpt-oss-120b
# Server-only secret. Never expose to the frontend or commit it.
# Groq API keys start with "gsk_" (console.groq.com > API Keys).
GROQ_API_KEY=gsk_your_groq_api_key_here
# Only needed when AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# Optional tuning:
# AI_EFFORT=low                 # reasoning effort: low|medium|high (Groq gpt-oss, etc.)
# AI_MAX_OUTPUT_TOKENS=1600
# AI_REQUEST_TIMEOUT_MS=60000
# AI_TEMPERATURE=0              # only used by providers that still accept it
# AI_SCORE_WEIGHTS=0.4,0.3,0.2,0.1   # skills,experience,requirements,education
# AI_SCREENING_ENABLED=true     # set to "false" to disable the pipeline entirely
